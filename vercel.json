{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "frontend/public/src",
  "rewrites": [
    {
      "source": "/api/wake",
      "destination": "https://conceptzero-stacked-api.onrender.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://conceptzero-stacked-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
